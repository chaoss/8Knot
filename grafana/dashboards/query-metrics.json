        {
          "refId": "avg",
          "datasource": {
            "type": "redis-datasource",
            "uid": "redis-metrics"
          },
          "type": "timeSeries",
          "command": "ts.mrange",
          "filter": "stage=e2e",
          "aggregation": "avg",
          "bucket": 300000,
          "legend": "query",
          "value": "query"
