        {
          "refId": "A",
          "datasource": {
            "type": "redis-datasource",
            "uid": "redis-metrics"
          },
          "type": "command",
          "command": "zrange",
          "keyName": "km:search:repo:30d",
          "min": "-15",
          "max": "-1",
          "zrangeQuery": ""
