        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "avg"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "${__field.name} (avg)"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "max"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "${__field.name} (max)"
